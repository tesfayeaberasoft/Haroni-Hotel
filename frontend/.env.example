# Use the built-in sample-data backend only for a local UI demo.
VITE_USE_DEMO_BACKEND=false

# Vite serves the frontend on localhost:5173 and proxies /api to this URL.
# XAMPP Apache maps /api directly to backend/public/.
VITE_PHP_BACKEND_URL=http://localhost

# The app always calls the same-origin /api path. Production hosting must proxy
# that path to backend/public/api as well.
VITE_API_BASE_URL=/api
